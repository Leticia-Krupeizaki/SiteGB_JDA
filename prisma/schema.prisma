// Banco do mural da comunidade (especificação, seção 10).
// Enums alinhados com src/types/mural.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MuralStatus {
  PENDING
  AWAITING_GUARDIAN_AUTHORIZATION
  APPROVED
  REJECTED
  REMOVED
}

enum MuralCategory {
  TREINOS
  GRADUACOES
  CAMPEONATOS
  EVENTOS
  COMUNIDADE
}

enum ContactType {
  WHATSAPP
  EMAIL
}

/// Avaliado pela equipe na moderação. Aprovação só com NOT_REQUIRED ou RECEIVED.
enum GuardianAuthorizationStatus {
  NOT_EVALUATED
  NOT_REQUIRED
  REQUIRED_PENDING
  RECEIVED
}

enum AdminRole {
  ADMIN
  MODERATOR
}

enum ModerationAction {
  SUBMITTED
  AWAITING_GUARDIAN
  APPROVED
  REJECTED
  REMOVED
  NOTE
}

enum RemovalRequestStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String?
  passwordHash String?
  providerId   String?   @unique
  role         AdminRole @default(MODERATOR)
  /// Conta desativada não entra e perde as sessões.
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         AdminSession[]
  moderatedPosts   MuralPost[]
  moderationEvents MuralModerationEvent[]
  resolvedRemovals MuralRemovalRequest[]
}

/// Sessão do painel. O cookie leva um token aleatório; aqui só fica o hash dele.
model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  adminId    String    @db.Uuid
  admin      Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([adminId])
}

model MuralPost {
  id           String        @id @default(uuid()) @db.Uuid
  studentName  String
  contactType  ContactType
  contactValue String
  caption      String?
  category     MuralCategory
  status       MuralStatus   @default(PENDING)

  showNamePublicly    Boolean @default(false)
  showCaptionPublicly Boolean @default(false)

  /// Imagem reprocessada (sem EXIF) no bucket privado.
  originalObjectKey String
  /// Derivado público, gerado só na aprovação.
  publicObjectKey   String?
  width             Int
  height            Int

  privacyPolicyVersion      String
  privacyAcceptedAt         DateTime
  publicationConsentVersion String
  publicationConsentAt      DateTime

  guardianAuthorizationStatus GuardianAuthorizationStatus @default(NOT_EVALUATED)
  thirdPartyRightsReviewed    Boolean                     @default(false)

  approvedAt      DateTime?
  moderatedById   String?   @db.Uuid
  moderatedBy     Admin?    @relation(fields: [moderatedById], references: [id])
  rejectionReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  removedAt DateTime?

  events          MuralModerationEvent[]
  removalRequests MuralRemovalRequest[]

  @@index([status, createdAt])
  @@index([category, status, createdAt])
  @@index([status, approvedAt])
  @@index([category, status, approvedAt])
}

model MuralModerationEvent {
  id             String           @id @default(uuid()) @db.Uuid
  postId         String           @db.Uuid
  post           MuralPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  /// Vazio quando a ação veio do sistema (ex.: envio público).
  adminId        String?          @db.Uuid
  admin          Admin?           @relation(fields: [adminId], references: [id])
  action         ModerationAction
  previousStatus MuralStatus?
  nextStatus     MuralStatus?
  reason         String?
  createdAt      DateTime         @default(now())

  @@index([postId, createdAt])
}

model MuralRemovalRequest {
  id               String               @id @default(uuid()) @db.Uuid
  postId           String?              @db.Uuid
  post             MuralPost?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  requesterContact String
  reason           String
  status           RemovalRequestStatus @default(OPEN)
  createdAt        DateTime             @default(now())
  resolvedAt       DateTime?
  resolvedById     String?              @db.Uuid
  resolvedBy       Admin?               @relation(fields: [resolvedById], references: [id])
  resolutionNote   String?

  @@index([status, createdAt])
}

/// Registro de tentativas para limitar envios por origem (IP com hash, nunca em claro).
model RateLimitHit {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
