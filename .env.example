# Copie para .env.local e preencha. Nunca versione o .env real.
# Para desenvolvimento local, os valores abaixo batem com o docker-compose.yml.

# Banco PostgreSQL (produção: Neon, Supabase etc.)
DATABASE_URL=postgresql://sitegb:sitegb@localhost:5432/sitegb

# Storage compatível com S3 (produção: Cloudflare R2, AWS S3 etc.)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
# Originais e fotos pendentes. Nunca público.
S3_BUCKET_PRIVATE=sitegb-private
# Só derivados de fotos aprovadas. Leitura pública.
S3_BUCKET_PUBLIC=sitegb-public
# URL base de leitura do bucket público (domínio do CDN em produção).
S3_PUBLIC_BASE_URL=http://localhost:8333/sitegb-public
S3_ACCESS_KEY_ID=sitegb-local
S3_SECRET_ACCESS_KEY=sitegb-local-secret

# Segredo do servidor: hash de IP no rate limit e, na Etapa 5, sessões.
AUTH_SECRET=troque-por-um-valor-aleatorio-longo

# Domínio final do site (SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
